# Local Codex Conductor. Uses the ChatGPT login from Codex CLI.
SWIMPHONY_CODEX_MODEL=gpt-5.6-terra
SWIMPHONY_CODEX_EFFORT=low
SWIMPHONY_CODEX_TIMEOUT_MS=45000

# Optional Philips Hue integration. Keep disabled until Phase 4.
HUE_ENABLED=false
HUE_BRIDGE_BASE_URL=https://192.168.x.x
# Optional: point to xangi's private hue.json instead of copying the key.
HUE_CONFIG_PATH=
HUE_APPLICATION_KEY=
HUE_GROUPED_LIGHT_ID=

# Optional local-only debugging.
SWIMPHONY_DEBUG=false
